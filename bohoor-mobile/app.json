{
  "expo": {
    "name": "bohoor-mobile",
    "slug": "bohoor-mobile",
    "version": "1.0.0",
    "scheme": "bohoor",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bohoor.app",
      "associatedDomains": [
        "applinks:buhoor-web.vercel.app",
        "applinks:buhoor.vercel.app"
      ]
    },
    "android": {
      "package": "com.bohoor.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "buhoor-web.vercel.app",
              "pathPrefix": "/units"
            },
            {
              "scheme": "https",
              "host": "buhoor-web.vercel.app",
              "pathPrefix": "/projects"
            },
            {
              "scheme": "https",
              "host": "buhoor-web.vercel.app",
              "pathPrefix": "/unit"
            },
            {
              "scheme": "https",
              "host": "buhoor-web.vercel.app",
              "pathPrefix": "/project"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bohoor"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "bf1eb52d-0e15-42b8-b4d1-61077ccc5d40"
      }
    }
  }
}
